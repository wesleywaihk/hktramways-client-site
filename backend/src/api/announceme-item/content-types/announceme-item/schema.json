{
  "kind": "collectionType",
  "collectionName": "announceme_items",
  "info": {
    "singularName": "announceme-item",
    "pluralName": "announceme-items",
    "displayName": "AnnouncementItem"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "announcement_types": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::announcement-type.announcement-type",
      "inversedBy": "announcement_items"
    },
    "dateTime": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "pageContent": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "actionButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "content.action-button",
      "repeatable": true
    }
  }
}
