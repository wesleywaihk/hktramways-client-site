{
  "collectionName": "components_content_news_items",
  "info": {
    "displayName": "newsItems",
    "icon": "television"
  },
  "options": {},
  "attributes": {
    "dateTime": {
      "type": "datetime",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "event",
        "discount",
        "news"
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "url": {
      "type": "string"
    },
    "openNewWindow": {
      "type": "boolean",
      "default": false
    },
    "noRefer": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "openNewWindow"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
